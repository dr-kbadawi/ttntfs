// Shared build configuration.
//
// Signing: set your Apple Developer Team ID here (or pass DEVELOPMENT_TEAM on
// the xcodebuild command line). The extension needs the managed capability
// "FSKit Module" (entitlement com.apple.developer.fskit.fsmodule) enabled for
// the App ID ch.techtag.ntfs.extension in the developer portal. See README.md.
NTFS_TEAM_ID = HU5S996C2K

// Core selection. "stub" links core/stub/ntfscore_stub.c (every operation
// returns ENOSYS). "real" excludes the stub and links the CMake output
// ../build/libntfscore.a. Switch with:  NTFS_CORE_MODE = real
NTFS_CORE_MODE = real

NTFS_CORE_EXCLUDE_stub =
NTFS_CORE_LDFLAGS_stub =
NTFS_CORE_EXCLUDE_real = ntfscore_stub.c
NTFS_CORE_LDFLAGS_real = $(SRCROOT)/../build/libntfscore.a

// Universal. FSKit itself is available on Intel -- the SDK's FSKit.tbd lists
// x86_64-macos, and Apple's own fskit.exfat module ships fat (x86_64 + arm64e)
// -- and nothing in the driver is architecture-specific. The core static
// library must carry both slices or the x86_64 link finds no symbols;
// CMakeLists.txt builds a universal archive by default.
ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO
